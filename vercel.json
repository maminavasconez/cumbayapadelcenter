{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/club", "destination": "/Club.dc.html" },
    { "source": "/academia", "destination": "/Academia.dc.html" },
    { "source": "/clases", "destination": "/Clases.dc.html" },
    { "source": "/streetfit", "destination": "/StreetFit.dc.html" },
    { "source": "/reservas", "destination": "/Reservas.dc.html" }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/Club.dc.html", "destination": "/club", "permanent": true },
    { "source": "/Academia.dc.html", "destination": "/academia", "permanent": true },
    { "source": "/Clases.dc.html", "destination": "/clases", "permanent": true },
    { "source": "/StreetFit.dc.html", "destination": "/streetfit", "permanent": true },
    { "source": "/Reservas.dc.html", "destination": "/reservas", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(webp|jpg|png|svg|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
